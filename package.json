{
  "name": "social-universe-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @social-universe/web dev",
    "dev:game": "pnpm --filter @social-universe/game dev",
    "dev:server": "pnpm --filter @social-universe/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  }
}
